{
  "id": "./",
  "name": "Arbitrage Radar",
  "short_name": "Arbitrage Radar",
  "description": "GPS-powered reseller sourcing app with an interactive local sourcing map, expanded retailer intelligence, clearance, return/bin stores, liquidation, estate sales, garage sales, flea markets, thrift stores, auctions and resale decisions.",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0b0f17",
  "theme_color": "#0c111b",
  "categories": [
    "business",
    "shopping",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Clearance Radar",
      "short_name": "Radar",
      "url": "./index.html?view=radar",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Hunt Mode",
